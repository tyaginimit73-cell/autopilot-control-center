# ── AutoPilot local agent ──────────────────────────────────────────────────
# Where the control plane lives. `npm run dev` serves http://localhost:3000;
# use http://<lan-ip>:3000 for a remote server.
SERVER_URL=http://localhost:3000

# Credentials: since Phase 2 the token lives in the secure store
# (~/.autopilot-agent/credentials.json, 0600) — see CREDENTIALS.md.
# These env vars are explicit overrides: secure store wins unless set.
DEVICE_TOKEN=
DEVICE_ID=

# Credential backend: file | keychain (keychain needs the optional `keytar` package).
CREDENTIAL_BACKEND=file
# Override the file-store path (must stay outside Git).
# AUTOPILOT_CREDENTIALS_FILE=

# Safety: when 1 the agent refuses every live run, even if the server asks for
# one. Phase 1 has no OS drivers, so live runs are refused unconditionally.
DRY_RUN=0

# Input driver: auto | robotjs | nutjs | simulated (Phase 3+; unused in Phase 1)
MOUSE_DRIVER=auto
KEYBOARD_DRIVER=auto
# Window manager driver: auto | powershell | simulated (Phase 4+; unused in Phase 1)
WINDOW_DRIVER=auto

# Browser automation (Phase 5+; unused in Phase 1)
HEADLESS=0
BROWSER_CDP_URL=
# leave empty to let Playwright launch its own isolated profile, e.g.:
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_EXECUTABLE_PATH=

# Local emergency stop, independent of the socket. Use the Windows logon-safe combo.
EMERGENCY_SHORTCUT=Ctrl+Shift+Esc

# How often to report heartbeat / pointer / window state (ms)
HEARTBEAT_MS=5000
POINTER_REPORT_MS=250
STATE_REPORT_MS=4000

# Recorder: capture OS-level input hooks while the dashboard is recording
RECORDER_ENABLED=1
# Do not capture keystrokes at all (recommended on shared machines)
RECORDER_KEYBOARD=1
# Mask anything that looks like a secret before it leaves the machine
RECORDER_MASK=1

{
  "name": "@autopilot/agent",
  "version": "1.0.0",
  "private": true,
  "description": "Local Windows automation agent for AutoPilot Control Center. Executes allowlisted commands with real OS input and Playwright.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "pair": "tsx src/cli.ts pair",
    "save-token": "tsx src/cli.ts save-token",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@nut-tree/nut-js": "^4.0.0",
    "robotjs": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
